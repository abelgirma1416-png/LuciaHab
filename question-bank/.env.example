# LuciaHab Question Bank Pipeline Environment Configuration
# Copy this file to .env and configure your variables

# AI Provider Configuration (Optional - template-based extraction works without any API keys)
# Supported AI_PROVIDER values: "template" (default/offline), "openai", "gemini", "anthropic", "ollama"
AI_PROVIDER=template

# If using OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# If using Google Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# If using Anthropic Claude:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# If using Local Ollama:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Supabase Configuration (Optional - for syncing approved questions to PostgreSQL)
# Backend / Admin operations require SUPABASE_SERVICE_ROLE_KEY (keep secret!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Frontend uses only anon public key:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
